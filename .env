# ==========================================
# SELLORA PRODUCTION DEPLOYMENT CONFIG
# ==========================================

# Database Configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sellora_db_secret_secure_password
POSTGRES_DB=sellora

# Application URLs (Ganti dengan domain asli Anda saat deploy)
NEXT_PUBLIC_STORE_DOMAIN=kamu.dijaminsuka.com
NEXT_PUBLIC_API_URL=https://api.dijaminsuka.com

# Backend Configurations
PORT=3001
JWT_SECRET=sellora-super-secret-key-for-prod

# Database Connection String untuk Container (backend)
# menggunakan internal Docker DNS 'db'
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

